# =============================================================================
# viralTier.ai — Environment Variables
# Copy this file to .env.local (web) and .env (worker, root)
# =============================================================================

# ── Convex ───────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=prod:your-deploy-key

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Worker (internal Docker communication) ────────────────────────────────────
# Redis inside Docker Compose
REDIS_URL=redis://redis:6379

# Shared secret between Convex HTTP actions and the worker
WORKER_SECRET=change-me-to-a-random-secret

# Worker calls back into Convex via HTTP actions
CONVEX_HTTP_URL=https://your-deployment.convex.cloud

# ── Local Dev Overrides ───────────────────────────────────────────────────────
# For local dev outside Docker, override REDIS_URL:
# REDIS_URL=redis://localhost:6379
